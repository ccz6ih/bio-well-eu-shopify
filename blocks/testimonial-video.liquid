{%- comment -%}
  Theme Block for video testimonials.

  The block is rendered by the parent section through:
  {% content_for 'blocks' %}

  The actual card markup is delegated to:
  snippets/testimonial-card.liquid
{%- endcomment -%}

<div class="testimonials-videos__cell">
  {% render 'testimonial-card', block: block %}
</div>

{% schema %}
{
  "name": "t:sections.testimonials-videos.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.title",
      "default": "Customer story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.description",
      "default": "<p>Add a short quote or summary from the customer.</p>"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.source.label",
      "options": [
        {
          "value": "media",
          "label": "t:sections.testimonials-videos.blocks.testimonial_video.source.options__1.label"
        },
        {
          "value": "url",
          "label": "t:sections.testimonials-videos.blocks.testimonial_video.source.options__2.label"
        }
      ],
      "default": "url"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials-videos.blocks.testimonial_video.header__video.content",
      "visible_if": "{{ block.settings.source == 'media' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.video.label",
      "visible_if": "{{ block.settings.source == 'media' }}"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials-videos.blocks.testimonial_video.header__video_url.content",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.video_url.label",
      "info": "t:sections.testimonials-videos.blocks.testimonial_video.video_url.info",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.cover_image",
      "info": "t:sections.testimonials-videos.blocks.testimonial_video.cover_image_info",
      "visible_if": "{{ block.settings.source == 'url' }}"
    }
  ]
}
{% endschema %}