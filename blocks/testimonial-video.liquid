<div class="testimonial-video">
  <h3>{{ block.settings.title }}</h3>

  <div>
    {{ block.settings.description }}
  </div>

  {% if block.settings.cover_image %}
    {{ block.settings.cover_image
      | image_url: width: 800
      | image_tag
    }}
  {% endif %}
</div>

{% schema %}
{
  "name": "Vidéo témoignage",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Customer story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Add a short quote or summary from the customer.</p>"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "URL de la vidéo"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Image de couverture"
    }
  ]
}
{% endschema %}