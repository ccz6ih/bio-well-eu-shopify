{%- comment -%}
  Video testimonials carousel section. Designed for the home page.
  Uses Theme Blocks of type testimonial-video in a horizontal Flickity slider.
  Only one video plays at a time via <testimonials-videos-carousel>
  in assets/theme.js.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --card-gap: {{ section.settings.gap }}px;
    --slides-mobile: {{ section.settings.slides_per_view_mobile }};
    --slides-tablet: {{ section.settings.slides_per_view_tablet }};
    --slides-desktop: {{ section.settings.slides_per_view_desktop }};
    {%- render 'section-variables', section: section -%}
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %} testimonials-videos-carousel">
  <div class="page-width relative">
    {%- render 'section-heading', section: section -%}

    <testimonials-videos-carousel class="testimonials-videos-carousel__wrapper block">
      <slider-element
        id="TestimonialCarousel-{{ section.id }}"
        class="testimonials-videos-carousel__slider slider"
        selector=".testimonials-videos-carousel__track > *"
        tabindex="0"
        role="region"
        aria-roledescription="{{ 'sections.slideshow.carousel' | t | escape }}"
        aria-label="{{ section.settings.heading | default: 'Testimonials' | escape }}"
      >
        <div class="testimonials-videos-carousel__track" role="list">
          {% content_for 'blocks' %}
        </div>
      </slider-element>

      {%- if section.settings.show_arrows -%}
        <div class="testimonials-videos-carousel__nav flex items-center justify-between gap-2">
          <button
            type="button"
            is="previous-button"
            class="testimonials-videos-carousel__arrow testimonials-videos-carousel__arrow--prev flex items-center justify-center rounded-full"
            aria-controls="TestimonialCarousel-{{ section.id }}"
            aria-label="{{ 'general.pagination.previous' | t | escape }}"
          >
            {%- render 'icon', icon: 'arrow-left-long', class: 'transform' -%}
          </button>

          <button
            type="button"
            is="next-button"
            class="testimonials-videos-carousel__arrow testimonials-videos-carousel__arrow--next flex items-center justify-center rounded-full"
            aria-controls="TestimonialCarousel-{{ section.id }}"
            aria-label="{{ 'general.pagination.next' | t | escape }}"
          >
            {%- render 'icon', icon: 'arrow-right-long', class: 'transform' -%}
          </button>
        </div>
      {%- endif -%}

      {%- if section.settings.show_dots -%}
        <slider-dots
          class="flickity-page-dots flex items-center justify-center"
          aria-controls="TestimonialCarousel-{{ section.id }}"
        >
          {%- comment -%}
            Dots are generated by the slider when using Theme Blocks.
            The existing slider JS can control the active page.
          {%- endcomment -%}
        </slider-dots>
      {%- endif -%}
    </testimonials-videos-carousel>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .testimonials-videos-carousel__slider {
    display: block;
    overflow-y: hidden;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
  }

  #shopify-section-{{ section.id }} .testimonials-videos-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (var(--slider-container) / var(--slides-mobile)) -
      (var(--card-gap) * (var(--slides-mobile) - 1) / var(--slides-mobile))
    );
    gap: var(--card-gap);
  }

  #shopify-section-{{ section.id }} .testimonials-videos-carousel__track > * {
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .testimonials-videos-carousel__track {
      grid-auto-columns: calc(
        (var(--slider-container) / var(--slides-tablet)) -
        (var(--card-gap) * (var(--slides-tablet) - 1) / var(--slides-tablet))
      );
    }
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .testimonials-videos-carousel__track {
      grid-auto-columns: calc(
        (var(--slider-container) / var(--slides-desktop)) -
        (var(--card-gap) * (var(--slides-desktop) - 1) / var(--slides-desktop))
      );
    }
  }

  #shopify-section-{{ section.id }} .testimonial-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .testimonial-card__media {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  #shopify-section-{{ section.id }} .testimonial-card__video,
  #shopify-section-{{ section.id }} .testimonial-card__placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .testimonial-card__body {
    padding-block-start: 16px;
  }

  #shopify-section-{{ section.id }} .testimonial-card__title {
    margin: 0 0 8px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .testimonial-card__description :where(p) {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .testimonials-videos-carousel__nav {
    margin-block-start: 24px;
  }

  #shopify-section-{{ section.id }} .testimonials-videos-carousel__arrow {
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--color-border, var(--color-foreground)) / 0.2);
    background: var(--color-background, transparent);
  }

  #shopify-section-{{ section.id }} .testimonials-videos-carousel__arrow svg {
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
    margin-block-start: 24px;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(var(--color-foreground, 0 0 0) / 0.2);
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .flickity-page-dot[aria-current="true"] {
    background: rgb(var(--color-foreground, 0 0 0) / 0.8);
  }
  @media (max-width:  767px){
    .testimonials-videos-carousel__nav{
      display: none!important;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.testimonials-videos-carousel.name",
