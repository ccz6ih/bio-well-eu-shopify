<div class="testimonial-video">
  <h3>{{ block.settings.title }}</h3>

  <div class="testimonial-video__description">
    {{ block.settings.description }}
  </div>

  {% if block.settings.cover_image != blank %}
    {{ block.settings.cover_image
      | image_url: width: 800
      | image_tag
    }}
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.testimonials-videos.blocks.testimonial_video.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.title",
      "default": "Customer story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.description",
      "default": "<p>Add a short quote or summary from the customer.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials-videos.blocks.testimonial_video.header__video.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.video_url.label",
      "info": "t:sections.testimonials-videos.blocks.testimonial_video.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.testimonials-videos.blocks.testimonial_video.cover_image",
      "info": "t:sections.testimonials-videos.blocks.testimonial_video.cover_image_info"
    }
  ]
}
{% endschema %}