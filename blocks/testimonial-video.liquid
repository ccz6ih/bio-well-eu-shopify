{%- comment -%}
  Theme Block for video testimonials.

  The block is rendered by the parent section through:
  {% content_for 'blocks' %}

  The actual card markup is delegated to:
  snippets/testimonial-card.liquid
{%- endcomment -%}

<div class="testimonials-videos__cell">
  {% render 'testimonial-card', block: block %}
</div>

{% schema %}
{
  "name": "t:general.sections.testimonials-videos.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:general.sections.testimonials-videos.blocks.testimonial_video.title",
      "default": "Customer story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.sections.testimonials-videos.blocks.testimonial_video.description",
      "default": "<p>Add a short quote or summary from the customer.</p>"
    },
    {
      "type": "header",
      "content": "t:general.sections.testimonials-videos.blocks.testimonial_video.header__video.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "label": "t:general.sections.testimonials-videos.blocks.testimonial_video.video_url.label",
      "info": "t:general.sections.testimonials-videos.blocks.testimonial_video.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:general.sections.testimonials-videos.blocks.testimonial_video.cover_image",
      "info": "t:general.sections.testimonials-videos.blocks.testimonial_video.cover_image_info"
    }
  ]
}
{% endschema %}