    "custom_liquid_BJX8fz": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "{%- comment -%}\n  Bio-Well contact page (2026-10-20): HubSpot form \"Contact\" in the page language (Italian -> English), placed\n  where the Shopify contact form was (left column; the address column on the right is kept; the Shopify form is\n  hidden by this script). Same look as the theme form. A visitor looking for a practitioner, or a practitioner\n  interested in Bio-Well, is sent to the Practitioners page or the Demo page of their language.\n  Generated by Prospection/_scripts/generer_section_contact.py.\n{%- endcomment -%}\n{%- liquid\n  assign langue = request.locale.iso_code | split: '-' | first\n  assign racine = routes.root_url\n  if racine == '/'\n    assign racine = ''\n  endif\n  case langue\n    when 'fr'\n      assign bw_form = 'b8146a0a-8a4b-4ded-8387-98a394441bd9'\n    when 'es'\n      assign bw_form = '413db906-0234-445c-9543-655fb6182abc'\n    when 'de'\n      assign bw_form = '21f9ed85-111a-46e5-9581-0aa474f04eaa'\n    when 'pt'\n      assign bw_form = 'f52a4128-311c-4f7e-88ea-18d2ad32e1f7'\n    when 'nl'\n      assign bw_form = 'ec58aa8e-c6cc-4b44-9dbc-5d09cdf4bb8a'\n    when 'el'\n      assign bw_form = '2d86fb9d-a3da-4e3a-ac98-e880659009df'\n    when 'fi'\n      assign bw_form = '927cd9e2-e787-4f01-81f1-8510cff25788'\n    when 'sv'\n      assign bw_form = '36266446-15c0-43f3-89b7-d1ef19f976a1'\n    else\n      assign bw_form = '2af41fcd-d0bd-4fd7-8b09-74031b497637'\n  endcase\n-%}\n<div id=\"bw-form-contact\" class=\"grow\" data-form=\"{{ bw_form }}\" data-langue=\"{{ langue }}\" data-racine=\"{{ racine }}\" style=\"max-width:760px;\"></div>\n<script src=\"//js-eu1.hsforms.net/forms/embed/v2.js\" charset=\"utf-8\"></script>\n<script>\n(function () {\n  var cible = document.getElementById('bw-form-contact');\n  var TXT = {\"fr\": [\"Pour trouver un praticien pr\\u00e8s de chez vous, remplissez notre formulaire d\\u00e9di\\u00e9 : nous vous envoyons les coordonn\\u00e9es des praticiens les plus proches.\", \"Trouver un praticien\", \"Pour d\\u00e9couvrir Bio-Well pour votre pratique, r\\u00e9servez directement votre d\\u00e9monstration en ligne de 30 minutes avec un formateur.\", \"R\\u00e9server ma d\\u00e9mo\"], \"en\": [\"To find a practitioner near you, fill in our dedicated form: we will send you the details of the nearest practitioners.\", \"Find a practitioner\", \"To discover Bio-Well for your practice, book your 30-minute online demo with a trainer directly.\", \"Book my demo\"], \"es\": [\"Para encontrar un profesional cerca de usted, rellene nuestro formulario espec\\u00edfico: le enviaremos los datos de los profesionales m\\u00e1s cercanos.\", \"Encontrar un profesional\", \"Para descubrir Bio-Well para su pr\\u00e1ctica, reserve directamente su demostraci\\u00f3n en l\\u00ednea de 30 minutos con un formador.\", \"Reservar mi demo\"], \"de\": [\"Um einen Praktiker in Ihrer N\\u00e4he zu finden, f\\u00fcllen Sie unser spezielles Formular aus: Wir senden Ihnen die Kontaktdaten der n\\u00e4chstgelegenen Praktiker.\", \"Praktiker finden\", \"Um Bio-Well f\\u00fcr Ihre Praxis kennenzulernen, buchen Sie direkt Ihre 30-min\\u00fctige Online-Demo mit einem Trainer.\", \"Demo buchen\"], \"pt\": [\"Para encontrar um terapeuta perto de si, preencha o nosso formul\\u00e1rio dedicado: enviamos-lhe os contactos dos terapeutas mais pr\\u00f3ximos.\", \"Encontrar um terapeuta\", \"Para descobrir a Bio-Well para a sua pr\\u00e1tica, reserve diretamente a sua demonstra\\u00e7\\u00e3o online de 30 minutos com um formador.\", \"Reservar a minha demo\"], \"nl\": [\"Om een beoefenaar bij u in de buurt te vinden, vult u ons speciale formulier in: we sturen u de gegevens van de dichtstbijzijnde beoefenaars.\", \"Vind een beoefenaar\", \"Om Bio-Well voor uw praktijk te ontdekken, boekt u direct uw online demo van 30 minuten met een trainer.\", \"Mijn demo boeken\"], \"el\": [\"\\u0393\\u03b9\\u03b1 \\u03bd\\u03b1 \\u03b2\\u03c1\\u03b5\\u03af\\u03c4\\u03b5 \\u03b8\\u03b5\\u03c1\\u03b1\\u03c0\\u03b5\\u03c5\\u03c4\\u03ae \\u03ba\\u03bf\\u03bd\\u03c4\\u03ac \\u03c3\\u03b1\\u03c2, \\u03c3\\u03c5\\u03bc\\u03c0\\u03bb\\u03b7\\u03c1\\u03ce\\u03c3\\u03c4\\u03b5 \\u03c4\\u03b7 \\u03c6\\u03cc\\u03c1\\u03bc\\u03b1 \\u03bc\\u03b1\\u03c2: \\u03b8\\u03b1 \\u03c3\\u03b1\\u03c2 \\u03c3\\u03c4\\u03b5\\u03af\\u03bb\\u03bf\\u03c5\\u03bc\\u03b5 \\u03c4\\u03b1 \\u03c3\\u03c4\\u03bf\\u03b9\\u03c7\\u03b5\\u03af\\u03b1 \\u03c4\\u03c9\\u03bd \\u03c0\\u03bb\\u03b7\\u03c3\\u03b9\\u03ad\\u03c3\\u03c4\\u03b5\\u03c1\\u03c9\\u03bd \\u03b8\\u03b5\\u03c1\\u03b1\\u03c0\\u03b5\\u03c5\\u03c4\\u03ce\\u03bd.\", \"\\u0392\\u03c1\\u03b5\\u03af\\u03c4\\u03b5 \\u03b8\\u03b5\\u03c1\\u03b1\\u03c0\\u03b5\\u03c5\\u03c4\\u03ae\", \"\\u0393\\u03b9\\u03b1 \\u03bd\\u03b1 \\u03b3\\u03bd\\u03c9\\u03c1\\u03af\\u03c3\\u03b5\\u03c4\\u03b5 \\u03c4\\u03bf Bio-Well \\u03b3\\u03b9\\u03b1 \\u03c4\\u03b7\\u03bd \\u03c0\\u03c1\\u03b1\\u03ba\\u03c4\\u03b9\\u03ba\\u03ae \\u03c3\\u03b1\\u03c2, \\u03ba\\u03bb\\u03b5\\u03af\\u03c3\\u03c4\\u03b5 \\u03b1\\u03c0\\u03b5\\u03c5\\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03c4\\u03b7\\u03bd online \\u03b5\\u03c0\\u03af\\u03b4\\u03b5\\u03b9\\u03be\\u03b7 30 \\u03bb\\u03b5\\u03c0\\u03c4\\u03ce\\u03bd \\u03bc\\u03b5 \\u03ad\\u03bd\\u03b1\\u03bd \\u03b5\\u03ba\\u03c0\\u03b1\\u03b9\\u03b4\\u03b5\\u03c5\\u03c4\\u03ae.\", \"\\u039a\\u03bb\\u03b5\\u03af\\u03c3\\u03c4\\u03b5 \\u03c4\\u03b7\\u03bd \\u03b5\\u03c0\\u03af\\u03b4\\u03b5\\u03b9\\u03be\\u03ae \\u03bc\\u03bf\\u03c5\"], \"fi\": [\"L\\u00f6yt\\u00e4\\u00e4ksesi terapeutin l\\u00e4helt\\u00e4si t\\u00e4yt\\u00e4 erillinen lomakkeemme: l\\u00e4het\\u00e4mme sinulle l\\u00e4himpien terapeuttien yhteystiedot.\", \"Etsi terapeutti\", \"Tutustu Bio-Welliin omassa ty\\u00f6ss\\u00e4si: varaa suoraan 30 minuutin verkkoesittely kouluttajan kanssa.\", \"Varaa esittely\"], \"sv\": [\"F\\u00f6r att hitta en terapeut n\\u00e4ra dig, fyll i v\\u00e5rt s\\u00e4rskilda formul\\u00e4r: vi skickar kontaktuppgifterna till de n\\u00e4rmaste terapeuterna.\", \"Hitta en terapeut\", \"F\\u00f6r att uppt\\u00e4cka Bio-Well f\\u00f6r din verksamhet, boka din 30 minuters onlinedemo med en utbildare direkt.\", \"Boka min demo\"], \"it\": [\"To find a practitioner near you, fill in our dedicated form: we will send you the details of the nearest practitioners.\", \"Find a practitioner\", \"To discover Bio-Well for your practice, book your 30-minute online demo with a trainer directly.\", \"Book my demo\"]};\n  var langue = cible.getAttribute('data-langue');\n  var t = TXT[langue] || TXT.en;\n  var racine = cible.getAttribute('data-racine');\n  var LIENS = { particulier: racine + '/pages/practitioners', praticien: racine + '/pages/demo' };\n  // line icons (Feather, MIT licence), one per choice\n  var ICONES = {\n    particulier: '<circle cx=\"11\" cy=\"11\" r=\"7\"/><line x1=\"21\" y1=\"21\" x2=\"16.2\" y2=\"16.2\"/>',\n    praticien: '<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><polyline points=\"16 11 18 13 22 9\"/>',\n    commande_sav: '<path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.3 7 12 12 20.7 7\"/><line x1=\"12\" y1=\"22\" x2=\"12\" y2=\"12\"/>',\n    presse: '<path d=\"M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"23\"/><line x1=\"8\" y1=\"23\" x2=\"16\" y2=\"23\"/>',\n    autre: '<path d=\"M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z\"/>'\n  };\n  // put the HubSpot form in place of the Shopify contact form, keep the right column\n  var ancien = document.querySelector('form[id^=\"ContactForm-\"]');\n  if (ancien) { ancien.parentElement.insertBefore(cible, ancien); ancien.style.display = 'none'; cible.style.maxWidth = ''; }\n  var CSS = [\n    'body {