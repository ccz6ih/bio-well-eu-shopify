        "liquid": "{%- comment -%}\n  Bio-Well demo page (2026-10-20): same look as the contact and practitioners forms. No text here: it only restyles\n  what the page content already shows in each language (the two choice buttons become tiles with line icons,\n  Feather MIT licence; the HubSpot demo form gets grey fields, labels inside, two columns, pill button).\n  Accent colour: the page teal #0f5a6e. Generated by Prospection/_scripts/generer_section_demo.py.\n{%- endcomment -%}\n<style>\n.bw-aiguillage { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.bw-aiguillage > .bw-choix-titre, .bw-aiguillage > .bw-particulier { grid-column: 1 / -1; }\n.bw-choix-titre { color: #171717 !important; font-size: 16px !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: 0 !important; margin-bottom: 0 !important; }\n.bw-choix { display: flex !important; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-align: center !important; margin: 0 !important; min-height: 120px; padding: 16px 14px !important; background: #ffffff !important; color: #171717 !important; border: 1px solid rgba(23, 23, 23, 0.12) !important; border-radius: 10px !important; transition: border-color 0.15s, background 0.15s, box-shadow 0.15s; }\n.bw-choix strong { color: #171717 !important; font-size: 15px !important; font-weight: 600; }\n.bw-choix span { color: rgba(23, 23, 23, 0.65) !important; font-size: 13px !important; line-height: 1.35; }\n.bw-choix svg { width: 24px; height: 24px; fill: none; stroke: #0f5a6e; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 4px; }\n.bw-choix:hover { background: #ffffff !important; border-color: #0f5a6e !important; }\n.bw-choix:hover strong { color: #171717 !important; }\n.bw-choix.bw-actif { background: #eef6f7 !important; border-color: #0f5a6e !important; box-shadow: 0 0 0 1px #0f5a6e; }\n.bw-choix.bw-actif strong { color: #171717 !important; }\n@media (max-width: 480px) { .bw-aiguillage { grid-template-columns: 1fr; } .bw-choix { min-height: 0; } }\n</style>\n<script>\n(function () {\n  // this section shows nothing itself: hide its empty block (the styles and the script keep working)\n  var moi = document.currentScript && document.currentScript.closest('.shopify-section');\n  if (moi) moi.style.display = 'none';\n  // line icons (Feather, MIT licence) for the two choice tiles\n  var ICONES = {\n    'bw-choix-pro': '<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><polyline points=\"16 11 18 13 22 9\"/>',\n    'bw-choix-particulier': '<circle cx=\"11\" cy=\"11\" r=\"7\"/><line x1=\"21\" y1=\"21\" x2=\"16.2\" y2=\"16.2\"/>'\n  };\n  Object.keys(ICONES).forEach(function (id) {\n    var b = document.getElementById(id);\n    if (!b || b.querySelector('svg')) return;\n    var s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n    s.setAttribute('viewBox', '0 0 24 24'); s.innerHTML = ICONES[id];\n    b.insertBefore(s, b.firstChild);\n  });\n  var CSS = \"body { background: transparent !important; font-family: Inter, sans-serif !important; color: #171717 !important; }\\nform.hs-form { display: grid !important; grid-template-columns: 1fr 1fr; column-gap: 16px; row-gap: 16px; max-width: none !important; }\\nform.hs-form > * { grid-column: 1 / -1; margin: 0 !important; max-width: none !important; }\\nform.hs-form > .hs_firstname, form.hs-form > .hs_lastname { grid-column: auto; }\\nform.hs-form > .hs_hs_language { display: none !important; }\\n@media (max-width: 420px) { form.hs-form { grid-template-columns: 1fr; } form.hs-form > * { grid-column: 1 / -1 !important; } }\\n.hs-form-field > label { font-family: Inter, sans-serif !important; font-size: 15px !important; font-weight: 500 !important; color: #171717 !important; margin-bottom: 8px !important; }\\n.bw-label-cache { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip: rect(0 0 0 0) !important; }\\n.hs-form-field .input { margin: 0 !important; }\\ninput.hs-input:not([type=radio]):not([type=checkbox]), textarea.hs-input, select.hs-input {\\n  width: 100% !important; height: 56px !important; box-sizing: border-box !important; padding: 0 20px !important;\\n  background-color: rgba(23, 23, 23, 0.04) !important; border: 0 !important; border-radius: 6px !important; box-shadow: none !important;\\n  font-family: Inter, sans-serif !important; font-size: 16px !important; color: #171717 !important; outline: none !important; }\\nselect.hs-input { -webkit-appearance: none; appearance: none; cursor: pointer; padding-right: 44px !important;\\n  background-image: url(\\\"data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2714%27 height=%2714%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%23171717%27 stroke-width=%272%27%3E%3Cpolyline points=%276 9 12 15 18 9%27/%3E%3C/svg%3E\\\") !important;\\n  background-repeat: no-repeat !important; background-position: right 18px center !important; }\\nselect.hs-input.bw-vide { color: rgba(23, 23, 23, 0.65) !important; }\\n.hs-fieldtype-intl-phone { display: flex !important; gap: 8px; width: 100% !important; height: auto !important; padding: 0 !important; background: none !important; }\\n.hs-fieldtype-intl-phone select.hs-input { width: 120px !important; flex: none; padding-left: 16px !important; }\\n.hs-fieldtype-intl-phone input.hs-input { flex: 1; min-width: 0; width: auto !important; }\\ninput.hs-input:focus, textarea.hs-input:focus, select.hs-input:focus { box-shadow: inset 0 0 0 1px rgba(23, 23, 23, 0.35) !important; }\\n.hs-input::placeholder { color: rgba(23, 23, 23, 0.65) !important; opacity: 1 !important; }\\n.inputs-list { list-style: none !important; padding: 0 !important; margin: 0 !important; }\\n.inputs-list li { margin: 0 0 8px !important; }\\n.hs-form-booleancheckbox-display, .hs-form-radio-display { display: flex !important; align-items: flex-start; gap: 12px; font-size: 14px !important; font-weight: 400 !important; color: #171717 !important; cursor: pointer; line-height: 1.45; }\\n.hs-form-booleancheckbox-display > span, .hs-form-radio-display > span { margin-left: 0 !important; padding-left: 0 !important; }\\n.hs-form-booleancheckbox-display input { width: 18px !important; height: 18px !important; margin: 2px 0 0 !important; accent-color: #0f5a6e; flex: none; }\\n.legal-consent-container, .legal-consent-container p, .legal-consent-container span { font-size: 13px !important; line-height: 1.5 !important; color: rgba(23, 23, 23, 0.7) !important; font-family: Inter, sans-serif !important; }\\n.hs-error-msgs { list-style: none !important; padding: 0 !important; margin: 6px 0 0 !important; }\\n.hs-error-msgs label, .hs-error-msg { color: #c0392b !important; font-size: 13px !important; font-weight: 400 !important; }\\n.hs_submit .actions { margin: 6px 0 0 !important; padding: 0 !important; text-align: left !important; }\\ninput.hs-button, .hs-button { background: #0f5a6e !important; border: 0 !important; border-radius: 60px !important; padding: 18px 28px !important;\\n  font-family: Inter, sans-serif !important; font-size: 15px !important; font-weight: 700 !important; color: #ffffff !important;\\n  box-shadow: none !important; text-shadow: none !important; cursor: pointer; width: auto !important; height: auto !important; line-height: 1.2 !important; }\\n.hs-button:hover { opacity: 0.9; }\";\n\n  // labels shown inside the fields (text fields: placeholder; lists: first option)\n  function libelles(d) {\n    var champs = d.querySelectorAll('.hs-fieldtype-text, .hs-fieldtype-textarea, .hs-fieldtype-phonenumber, .hs-fieldtype-select');\n    for (var i = 0; i < champs.length; i++) {\n      var bloc = champs[i], label = bloc.querySelector(':scope > label');\n      if (!label || bloc.getAttribute('data-bw') || bloc.classList.contains('hs_hs_language')) continue;\n      var texte = label.innerText.replace(/\\*/g, '').trim();\n      var saisie = bloc.querySelector('input.hs-input:not([type=hidden]), textarea.hs-input');\n      var liste = bloc.classList.contains('hs-fieldtype-select') ? bloc.querySelector('select.hs-input') : null;\n      if (liste) {\n        var vide = liste.querySelector('option[value=\"\"]');\n        if (vide) vide.textContent = texte;\n        liste.classList.toggle('bw-vide', !liste.value);\n        liste.addEventListener('change', function (e) { e.target.classList.toggle('bw-vide', !e.target.value); });\n      } else if (saisie) {\n        saisie.setAttribute('placeholder', texte);\n      } else continue;\n      label.classList.add('bw-label-cache');\n      bloc.setAttribute('data-bw', '1');\n    }\n  }\n\n  function habiller() {\n    var f = document.querySelector('.form-wrapper iframe.hs-form-iframe');   // only the demo form of the page\n    var d = f && f.contentDocument;\n    if (!d || !d.head || !d.querySelector('form')) return;\n    if (!d.getElementById('bw-style-demo')) {\n      var s = d.createElement('style');\n      s.id = 'bw-style-demo'; s.textContent = CSS;\n      d.head.appendChild(s);\n    }\n    libelles(d);\n    // fields that appear later (e.g. \"specify your profession\" when Other is chosen) get the same look\n    if (!d.bwEcoute) {\n      d.bwEcoute = true;\n      d.addEventListener('change', function () { setTimeout(function () { libelles(d); }, 80); }, true);\n    }\n  }\n  window.addEventListener('message', function (e) { if (e.data && e.data.type === 'hsFormCallback') setTimeout(habiller, 50); });\n  var n = 0, minuteur = setInterval(function () { habiller(); if (++n > 60) clearInterval(minuteur); }, 400);\n})();\n</script>",
