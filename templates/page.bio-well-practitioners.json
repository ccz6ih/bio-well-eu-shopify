    "custom_liquid_hfNnQa": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "{%- comment -%}\n  Bio-Well practitioners page (2026-10-19): HubSpot form \"Trouver un praticien\" in the page language\n  (Italian -> English), replacing the Shopify contact form (hidden).\n  2026-10-20: styled like the theme's contact form (grey fields without border, label inside the field,\n  two columns, blue pill button, Inter).\n{%- endcomment -%}\n{%- liquid\n  assign langue = request.locale.iso_code | split: '-' | first\n  case langue\n    when 'fr'\n      assign bw_form = 'a09aadc0-c4f7-47ed-b551-d02068887568'\n    when 'es'\n      assign bw_form = 'efa0b67f-76d4-4c32-ba02-1034e5657267'\n    when 'de'\n      assign bw_form = 'c6b1c2f0-02e7-4115-8acb-4d4f99f441b7'\n    when 'pt'\n      assign bw_form = '0357090d-e76a-4f31-937e-de1e322fc1e0'\n    when 'nl'\n      assign bw_form = '3cc7594f-1989-4bc1-9736-a73ac9effb72'\n    when 'el'\n      assign bw_form = '128f1e61-b99b-453e-868a-050e158c82cd'\n    when 'fi'\n      assign bw_form = '98cb4a0b-d20b-4d48-8e45-bfabcd2c6d1d'\n    when 'sv'\n      assign bw_form = 'c4d35763-6a15-41e6-822e-6237bd032c5c'\n    else\n      assign bw_form = '1611a9fd-5dbd-47df-8148-df623bc35ec2'\n  endcase\n-%}\n<div class=\"page-width\" style=\"padding-bottom:56px;\">\n  <div id=\"bw-form-praticien\" data-form=\"{{ bw_form }}\" style=\"max-width:760px;\"></div>\n</div>\n<script src=\"//js-eu1.hsforms.net/forms/embed/v2.js\" charset=\"utf-8\"></script>\n<script>\n(function () {\n  var cible = document.getElementById('bw-form-praticien');\n  var CSS = [\n    'body { background: transparent !important; font-family: Inter, sans-serif !important; color: #171717 !important; }',\n    'form.hs-form { display: grid !important; grid-template-columns: 1fr 1fr; column-gap: 24px; row-gap: 20px; max-width: none !important; }',\n    'form.hs-form > * { grid-column: 1 / -1; margin: 0 !important; max-width: none !important; }',\n    'form.hs-form > .hs_firstname, form.hs-form > .hs_lastname, form.hs-form > .hs_email, form.hs-form > .hs_city,',\n    'form.hs-form > .hs_zip, form.hs-form > .hs_country { grid-column: auto; }',\n    'form.hs-form > .hs_hs_language { display: none !important; }',\n    '@media (max-width: 600px) { form.hs-form { grid-template-columns: 1fr; } form.hs-form > * { grid-column: 1 / -1 !important; } }',\n    '.hs-form-field > label, .hs-form-field > legend { font-family: Inter, sans-serif !important; font-size: 16px !important; font-weight: 500 !important; color: #171717 !important; margin-bottom: 10px !important; }',\n    '.bw-label-cache { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip: rect(0 0 0 0) !important; }',\n    '.hs-form-field .input { margin: 0 !important; }',\n    'input.hs-input:not([type=radio]):not([type=checkbox]), textarea.hs-input, select.hs-input {',\n    '  width: 100% !important; height: 62px !important; box-sizing: border-box !important; padding: 0 26px !important;',\n    '  background: rgba(23, 23, 23, 0.04) !important; border: 0 !important; border-radius: 6px !important; box-shadow: none !important;',\n    '  font-family: Inter, sans-serif !important; font-size: 16px !important; color: #171717 !important; outline: none !important; }',\n    'textarea.hs-input { height: 168px !important; padding: 22px 26px !important; resize: vertical; }',\n    'input.hs-input:focus, textarea.hs-input:focus { box-shadow: inset 0 0 0 1px rgba(23, 23, 23, 0.35) !important; }',\n    '.hs-input::placeholder { color: rgba(23, 23, 23, 0.65) !important; opacity: 1 !important; }',\n    '.inputs-list { list-style: none !important; padding: 0 !important; margin: 0 !important; }',\n    '.inputs-list li { margin: 0 0 10px !important; }',\n    '.hs-form-radio-display, .hs-form-booleancheckbox-display { display: flex !important; align-items: flex-start; gap: 12px; font-size: 15px !important; font-weight: 400 !important; color: #171717 !important; cursor: pointer; }',\n    '.hs-form-radio-display input, .hs-form-booleancheckbox-display input { width: 18px !important; height: 18px !important; margin: 2px 0 0 !important; accent-color: #0759b5; flex: none; }',\n    '.legal-consent-container, .legal-consent-container p, .legal-consent-container span { font-size: 13px !important; line-height: 1.5 !important; color: rgba(23, 23, 23, 0.7) !important; font-family: Inter, sans-serif !important; }',\n    '.hs-error-msgs { list-style: none !important; padding: 0 !important; margin: 6px 0 0 !important; }',\n    '.hs-error-msgs label, .hs-error-msg { color: #c0392b !important; font-size: 13px !important; font-weight: 400 !important; }',\n    '.hs_submit .actions { margin: 6px 0 0 !important; padding: 0 !important; text-align: left !important; }',\n    '.hs-form-radio-display > span, .hs-form-booleancheckbox-display > span { margin-left: 0 !important; padding-left: 0 !important; }',\n    'input.hs-button, .hs-button { background: #0759b5 !important; border: 0 !important; border-radius: 60px !important; padding: 18px 26px !important;',\n    '  font-family: Inter, sans-serif !important; font-size: 15px !important; font-weight: 700 !important; color: #ffffff !important;',\n    '  box-shadow: none !important; text-shadow: none !important; cursor: pointer; width: auto !important; height: auto !important; line-height: 1.2 !important; }',\n    '.hs-button:hover { opacity: 0.9; }',\n    '.submitted-message { font-family: Inter, sans-serif !important; color: #171717 !important; }'\n  ].join('\\n');\n\n  function creer() {\n    if (!window.hbspt) return setTimeout(creer, 200);\n    if (cible.getAttribute('data-cree')) return;\n    cible.setAttribute('data-cree', '1');\n    hbspt.forms.create({ region: 'eu1', portalId: '25309101', formId: cible.getAttribute('data-form'), target: '#bw-form-praticien' });\n  }\n  creer();\n\n  // text-field labels shown inside the field, like the theme contact form\n  function libellesDansLesChamps(d) {\n    var champs = d.querySelectorAll('.hs-fieldtype-text, .hs-fieldtype-textarea, .hs-fieldtype-phonenumber');\n    for (var i = 0; i < champs.length; i++) {\n      var bloc = champs[i], label = bloc.querySelector(':scope > label'), saisie = bloc.querySelector('input.hs-input, textarea.hs-input');\n      if (!label || !saisie || bloc.getAttribute('data-bw')) continue;\n      var texte = label.innerText.replace(/\\*/g, '').trim();\n      var exemple = saisie.getAttribute('placeholder');\n      saisie.setAttribute('placeholder', exemple && saisie.tagName === 'TEXTAREA' ? texte + '\\n' + exemple : texte);\n      label.classList.add('bw-label-cache');\n      bloc.setAttribute('data-bw', '1');\n    }\n  }\n\n  function habiller() {\n    var f = cible.querySelector('iframe.hs-form-iframe');\n    var d = f && f.contentDocument;\n    if (!d || !d.head || !d.querySelector('form')) return;\n    if (!d.getElementById('bw-police')) {\n      var l = d.createElement('link');\n      l.id = 'bw-police'; l.rel = 'stylesheet';\n      l.href = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap';\n      d.head.appendChild(l);\n      var s = d.createElement('style');\n      s.id = 'bw-style'; s.textContent = CSS;\n      d.head.appendChild(s);\n    }\n    libellesDansLesChamps(d);\n  }\n  window.addEventListener('message', function (e) { if (e.data && e.data.type === 'hsFormCallback') setTimeout(habiller, 50); });\n  var n = 0, t = setInterval(function () { habiller(); if (++n > 40) clearInterval(t); }, 400);\n})();\n</script>",
