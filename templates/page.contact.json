eight: 700; font-size: 15px; }'\n  ].join('\\n');\n\n  function creer() {\n    if (!window.hbspt) return setTimeout(creer, 200);\n    if (cible.getAttribute('data-cree')) return;\n    cible.setAttribute('data-cree', '1');\n    hbspt.forms.create({ region: 'eu1', portalId: '25309101', formId: cible.getAttribute('data-form'), target: '#bw-form-contact' });\n  }\n  creer();\n\n  // text-field labels shown inside the field, like the theme contact form\n  function libellesDansLesChamps(d) {\n    var champs = d.querySelectorAll('.hs-fieldtype-text, .hs-fieldtype-textarea, .hs-fieldtype-phonenumber');\n    for (var i = 0; i < champs.length; i++) {\n      var bloc = champs[i], label = bloc.querySelector(':scope > label'), saisie = bloc.querySelector('input.hs-input, textarea.hs-input');\n      if (!label || !saisie || bloc.getAttribute('data-bw')) continue;\n      label.classList.add('bw-label-cache');\n      saisie.setAttribute('placeholder', label.innerText.replace(/\\*/g, '').trim());\n      bloc.setAttribute('data-bw', '1');\n    }\n  }\n\n  // patient or practitioner: hide the rest of the form and send them to the right page\n  function aiguiller(d, valeur) {\n    var form = d.querySelector('form'), guide = d.getElementById('bw-guide');\n    var choix = form.querySelectorAll('.hs_bw_motif_contact .hs-form-radio-display');\n    for (var k = 0; k < choix.length; k++) { var r = choix[k].querySelector('input'); choix[k].classList.toggle('bw-choisi', !!(r && r.checked)); }\n    var vers = valeur === 'particulier' || valeur === 'praticien';\n    if (!guide) {\n      guide = d.createElement('div'); guide.id = 'bw-guide'; guide.className = 'bw-guide bw-masque';\n      var motif = form.querySelector('.hs_bw_motif_contact');\n      motif.parentNode.insertBefore(guide, motif.nextSibling);\n    }\n    for (var i = 0; i < form.children.length; i++) {\n      var el = form.children[i];\n      if (el === guide || el.classList.contains('hs_bw_motif_contact') || el.tagName === 'INPUT' || el.tagName === 'IFRAME') continue;\n      el.classList.toggle('bw-masque', vers);\n    }\n    guide.classList.toggle('bw-masque', !vers);\n    if (vers) {\n      var p = valeur === 'particulier' ? [t[0], t[1]] : [t[2], t[3]];\n      guide.innerHTML = '';\n      var texte = d.createElement('p'); texte.textContent = p[0];\n      var lien = d.createElement('a'); lien.textContent = p[1]; lien.href = LIENS[valeur]; lien.target = '_top';\n      guide.appendChild(texte); guide.appendChild(lien);\n    }\n  }\n\n  function habiller() {\n    var f = cible.querySelector('iframe.hs-form-iframe');\n    var d = f && f.contentDocument;\n    if (!d || !d.head || !d.querySelector('form')) return;\n    if (!d.getElementById('bw-police')) {\n      var l = d.createElement('link');\n      l.id = 'bw-police'; l.rel = 'stylesheet';\n      l.href = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap';\n      d.head.appendChild(l);\n      var s = d.createElement('style');\n      s.id = 'bw-style'; s.textContent = CSS;\n      d.head.appendChild(s);\n    }\n    libellesDansLesChamps(d);\n    var radios = d.querySelectorAll('input[name=\"bw_motif_contact\"]');\n    for (var i = 0; i < radios.length; i++) {\n      if (radios[i].getAttribute('data-bw')) continue;\n      radios[i].setAttribute('data-bw', '1');\n      var tuile = radios[i].closest('label');\n      if (tuile && !tuile.querySelector('svg') && ICONES[radios[i].value]) {\n        var icone = d.createElementNS('http://www.w3.org/2000/svg', 'svg');\n        icone.setAttribute('viewBox', '0 0 24 24'); icone.innerHTML = ICONES[radios[i].value];\n        tuile.insertBefore(icone, tuile.querySelector('span'));\n      }\n      radios[i].addEventListener('change', function (e) { aiguiller(d, e.target.value); });\n    }\n  }\n  window.addEventListener('message', function (e) { if (e.data && e.data.type === 'hsFormCallback') setTimeout(habiller, 50); });\n  var n = 0, minuteur = setInterval(function () { habiller(); if (++n > 40) clearInterval(minuteur); }, 400);\n})();\n</script>",
